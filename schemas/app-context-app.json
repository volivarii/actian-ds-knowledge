{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actian-ds.example.com/schemas/app-context-app.json",
  "title": "App-context app (per-record frontmatter)",
  "type": "object",
  "required": ["_schema_version", "slug", "label", "purpose", "users", "header", "sidebar", "signals"],
  "additionalProperties": false,
  "properties": {
    "_schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 60 },
    "label": { "type": "string" },
    "purpose": { "type": "string", "description": "One-paragraph statement of what the app is for." },
    "users": { "type": "array", "items": { "type": "string" } },
    "header": { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "type": "string", "description": "Header variant; matches the DS global-header App type axis." } } },
    "sidebar": { "type": "array", "items": { "type": "object", "required": ["label", "id"], "additionalProperties": false, "properties": { "label": { "type": "string" }, "id": { "type": "string" } } } },
    "signals": { "type": "array", "items": { "type": "string" } }
  }
}
