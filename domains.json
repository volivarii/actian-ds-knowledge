{
  "_schema_version": 1,
  "_note": "Per-domain authoring contract. Hand-authored source of truth; governed by schemas/domains.json; checked by scripts/validate/validate-domains.js. STEP 4's derive engine will read this.",
  "domains": {
    "categories": {
      "summary": "Component category defaults — anatomy/variants/refs from frontmatter; body mirrored verbatim to dist .md.",
      "src": "components/src/categories/*.md",
      "generator": "scripts/categories/derive-categories.js",
      "frontmatterSchema": "schemas/category-defaults.json",
      "body": { "parse": "none", "mirror": true, "field": null },
      "distShape": "per-record+bundle"
    },
    "foundations": {
      "summary": "Foundations guidance — body parsed into a Pattern-H section tree; also emits a synthesized foundations.md concatenation (not byte-verbatim).",
      "src": "foundations/src/*.md",
      "generator": "scripts/foundations/derive-foundations.js",
      "frontmatterSchema": null,
      "body": { "parse": "sections", "mirror": true, "field": null },
      "distShape": "pattern-H-tree",
      "wysiwyg": {
        "safePaths": [
          "foundations/src/design-guidelines.md",
          "foundations/src/intro.md",
          "foundations/src/handoff-protocol.md",
          "foundations/src/related-guidelines.md",
          "foundations/src/table-of-contents.md"
        ],
        "distEquivalence": {
          "engine": "section-dist",
          "sourceRel": "foundations/src/",
          "applySkipH2Slugs": true
        }
      }
    },
    "accessibility": {
      "summary": "WCAG guidance — body parsed into a Pattern-H section tree (same engine as foundations).",
      "src": "accessibility/src/*.md",
      "generator": "scripts/accessibility/derive-a11y-sections.js",
      "frontmatterSchema": null,
      "body": { "parse": "sections", "mirror": false, "field": null },
      "distShape": "pattern-H-tree",
      "wysiwyg": {
        "safePaths": [
          "accessibility/src/color-contrast.md",
          "accessibility/src/designer-handoff-checklist.md",
          "accessibility/src/error-prevention.md",
          "accessibility/src/focus-keyboard.md",
          "accessibility/src/intro.md",
          "accessibility/src/motion.md",
          "accessibility/src/principles.md",
          "accessibility/src/reading-order-landmarks.md",
          "accessibility/src/session-timeout-warnings.md",
          "accessibility/src/touch-pointer.md",
          "accessibility/src/typography.md"
        ],
        "distEquivalence": {
          "engine": "section-dist",
          "sourceRel": "accessibility/src/",
          "rootAnchor": "accessibility"
        }
      }
    },
    "guidelines": {
      "summary": "Per-component guidelines — body domains (content/usage/design/behavior) parsed into sections + kept verbatim per-domain; frontmatter in sibling _meta.yml (+tokens.yml).",
      "src": "components/src/*/{content,usage,design,behavior}.md",
      "generator": "scripts/components/derive-guidelines.js",
      "frontmatterSchema": "schemas/guideline-meta.json",
      "body": { "parse": "sections", "mirror": true, "field": null },
      "distShape": "per-record+bundle",
      "wysiwyg": {
        "safePaths": [
          "components/src/alert-banner/content.md",
          "components/src/badge/content.md",
          "components/src/breadcrumbs/content.md",
          "components/src/button/content.md",
          "components/src/card/content.md",
          "components/src/chat-with-ai-steward/design.md",
          "components/src/chat-with-ai-steward/usage.md",
          "components/src/checkbox/content.md",
          "components/src/combo-box/content.md",
          "components/src/confirmation/content.md",
          "components/src/drawer-side-panel/content.md",
          "components/src/dropdown-select/content.md",
          "components/src/empty-state/content.md",
          "components/src/error-state/content.md",
          "components/src/filters/content.md",
          "components/src/global-header/content.md",
          "components/src/global-toast/content.md",
          "components/src/inline-toast/content.md",
          "components/src/loader-with-logo/content.md",
          "components/src/loader/content.md",
          "components/src/loading-skeleton/content.md",
          "components/src/maintenance-state/content.md",
          "components/src/modal/content.md",
          "components/src/multi-select/content.md",
          "components/src/notification-dropdown/content.md",
          "components/src/notification/content.md",
          "components/src/popover/content.md",
          "components/src/progress-bar-small/content.md",
          "components/src/search/content.md",
          "components/src/side-nav/content.md",
          "components/src/spinner/content.md",
          "components/src/stepper/content.md",
          "components/src/sticky-footer/content.md",
          "components/src/success-state/content.md",
          "components/src/tabs/content.md",
          "components/src/tag/content.md",
          "components/src/text-input/design.md",
          "components/src/toggle-control/content.md",
          "components/src/tooltip/content.md",
          "components/src/upload-file/content.md",
          "components/src/whats-new/content.md"
        ],
        "distEquivalence": {
          "engine": "guideline-sections"
        }
      }
    },
    "app-context/apps": {
      "summary": "App-context apps — body parsed into H2/H3 sections.",
      "src": "app-context/src/apps/*.md",
      "generator": "scripts/app-context/derive-app-context.js",
      "frontmatterSchema": "schemas/app-context-app.json",
      "body": { "parse": "sections", "mirror": false, "field": null },
      "distShape": "single-object"
    },
    "app-context/entities": {
      "summary": "App-context entities — body normalized verbatim into a single description field.",
      "src": "app-context/src/entities/*.md",
      "generator": "scripts/app-context/derive-app-context.js",
      "frontmatterSchema": "schemas/app-context-entity.json",
      "body": { "parse": "none", "mirror": false, "field": "description" },
      "distShape": "single-object"
    },
    "app-context/patterns": {
      "summary": "App-context patterns — body normalized verbatim into a single description field.",
      "src": "app-context/src/patterns/*.md",
      "generator": "scripts/app-context/derive-app-context.js",
      "frontmatterSchema": "schemas/app-context-pattern.json",
      "body": { "parse": "none", "mirror": false, "field": "description" },
      "distShape": "single-object"
    },
    "content/global": {
      "summary": "Global content/writing guidance — bodies concatenated verbatim into one global.md (+ words-to-avoid.json).",
      "src": "content/src/{writing,product}/*.md",
      "generator": "scripts/content/derive-content.js",
      "frontmatterSchema": "schemas/content.json",
      "body": { "parse": "none", "mirror": true, "field": null },
      "distShape": "single-object",
      "wysiwyg": {
        "safePaths": [
          "content/src/global-guidelines.md",
          "content/src/format-spec.md",
          "content/src/product/lineage-specific-ui.md",
          "content/src/product/object-preview-panels.md",
          "content/src/product/related-content-panels.md",
          "content/src/writing/abbreviations-and-articles.md",
          "content/src/writing/acronyms.md",
          "content/src/writing/grid-and-spacing.md",
          "content/src/writing/numerical-formatting.md",
          "content/src/writing/plurals.md",
          "content/src/writing/prepositions.md",
          "content/src/writing/voice-and-tone.md",
          "content/src/writing/writing-style.md"
        ]
      }
    },
    "content/patterns": {
      "summary": "Content pattern files — parsed into sections and fanned out (appended) into component guideline records.",
      "src": "content/src/patterns/*.md",
      "generator": "scripts/content/fanout-patterns.js",
      "frontmatterSchema": "schemas/content.json",
      "body": { "parse": "sections", "mirror": false, "field": null },
      "distShape": "embedded",
      "wysiwyg": {
        "safePaths": [
          "content/src/patterns/empty-and-system-states.md",
          "content/src/patterns/forms.md",
          "content/src/patterns/icons.md",
          "content/src/patterns/loading-and-progress.md",
          "content/src/patterns/notifications-and-messaging.md",
          "content/src/patterns/onboarding.md",
          "content/src/patterns/validation-messages.md",
          "content/src/patterns/wizards.md"
        ]
      }
    },
    "graph": {
      "summary": "Knowledge graph — derived from dist artifacts (+ content/src frontmatter for related-component edges); reads no prose body.",
      "src": null,
      "generator": "scripts/graph/derive-graph.js",
      "frontmatterSchema": null,
      "body": { "parse": "none", "mirror": false, "field": null },
      "distShape": "single-object"
    },
    "tokens": {
      "summary": "Design tokens — hand-authored JSON data file; no markdown body, so no frontmatterSchema applies (null is permanently correct, not a gap).",
      "src": "tokens/tokens.json",
      "generator": null,
      "frontmatterSchema": null,
      "body": { "parse": "none", "mirror": false, "field": null },
      "distShape": "single-object"
    },
    "canonical-sections": {
      "summary": "Canonical design-section catalogue — JSON→JSON projection; no markdown body.",
      "src": "components/src/canonical-sections.json",
      "generator": "scripts/components/derive-canonical-sections.js",
      "frontmatterSchema": "schemas/canonical-sections.json",
      "body": { "parse": "none", "mirror": false, "field": null },
      "distShape": "single-object"
    }
  }
}
