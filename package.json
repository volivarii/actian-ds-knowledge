{
  "name": "actian-ds-knowledge",
  "version": "0.3.4",
  "private": true,
  "description": "Actian Design System knowledge layer — tokens, components, guidelines, foundations, content. Consumed by the Actian DS Claude plugin.",
  "scripts": {
    "sync": "node scripts/sync/sync-from-figma.js",
    "derive:foundations": "node scripts/foundations/derive-foundations.js --md foundations/src/foundations.md --map scripts/foundations/foundations.parser.json --out foundations/dist",
    "derive:content": "node scripts/content/derive-content.js --src content/src --index content/src/content-index.md --out content/dist/content.md",
    "validate:manifest": "node scripts/validate-manifest.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "marked": "^14.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
