{
  "name": "actian-ds-knowledge",
  "version": "0.25.0",
  "private": true,
  "description": "Actian Design System knowledge layer — tokens, components, guidelines, foundations, content. Consumed by the Actian DS Claude plugin.",
  "scripts": {
    "sync": "node scripts/sync/sync-from-figma.js",
    "derive:foundations": "node scripts/foundations/derive-foundations.js --src-dir foundations/src --out foundations/dist",
    "derive:content": "node scripts/content/derive-content.js --src content/src --index content/src/content-index.md",
    "derive:categories": "node scripts/categories/__cli.js",
    "derive:guidelines": "node scripts/components/__cli.js",
    "validate:manifest": "node scripts/validate-manifest.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "marked": "^14.1.3",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=20"
  }
}
