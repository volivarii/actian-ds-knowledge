{
  "name": "actian-ds-knowledge",
  "version": "0.34.156",
  "private": true,
  "description": "Actian Design System knowledge layer — tokens, components, guidelines, foundations, content. Consumed by the Actian DS Claude plugin.",
  "scripts": {
    "sync": "node scripts/sync/sync-from-figma.js",
    "derive:foundations": "node scripts/foundations/derive-foundations.js --src-dir foundations/src --out foundations/dist",
    "derive:tokens": "node scripts/tokens/derive-tokens.js",
    "derive:content": "node scripts/content/derive-content.js --src content/src --index content/src/content-index.md",
    "derive:canonical-sections": "node scripts/components/derive-canonical-sections.js",
    "derive:app-context": "node scripts/app-context/__cli.js",
    "derive:categories": "node scripts/categories/__cli.js",
    "derive:guidelines": "node scripts/components/__cli.js",
    "derive:identity": "node scripts/components/derive-identity.js",
    "derive:icons": "node scripts/icons/__cli.js",
    "derive:accessibility": "node scripts/accessibility/derive-a11y-index.js && node scripts/accessibility/derive-a11y-sections.js",
    "derive:render": "node scripts/render/derive-retired-slugs.js && node scripts/render/derive-canonical.js && node scripts/render/derive-contract.js && node scripts/render/derive-sparse-render.js && node scripts/render/derive-dtcg.js && node scripts/render/fidelity-check.js && node scripts/render/derive-usage-notes.js",
    "validate:manifest": "node scripts/validate-manifest.js",
    "validate:anatomy": "node scripts/validate/validate-anatomy.js",
    "validate:domains": "node scripts/validate/validate-domains.js",
    "derive:vendor-include": "node scripts/derive-vendor-include.js",
    "derive:llms": "node scripts/llms-txt-generate.js",
    "sync:version": "node scripts/lib/sync-knowledge-version.js",
    "derive:graph": "node scripts/graph/derive-graph.js",
    "validate:graph": "node scripts/graph/validate-graph.js",
    "render:tokens": "node scripts/render-token-reference.js",
    "test": "find tests -name '*.test.js' -type f -print0 | xargs -0 node --test"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "marked": "^14.1.3",
    "sharp": "^0.34.5",
    "svgo": "^3.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
