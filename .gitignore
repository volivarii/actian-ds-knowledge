# Node
node_modules
npm-debug.log
yarn-error.log

# OS
.DS_Store
Thumbs.db

# Local env
.env
.env.local
*.local

# Editor
.vscode/
.idea/

# Sync working artifacts
.sync-cache/
*.tmp

# Federation: working artifacts (plans, specs, audits) — never tracked
**/docs/superpowers/
**/.superpowers/

# Figma file keys (sensitive — create from .figma-keys.json.example)
.figma-keys.json
release-notes/sync-*.md

# Tokens: local-only raw Figma export, a P2 parity-reference oracle for the
# deriver. NOT read by derive-tokens.js or any test, and NOT covered by
# paths-manifest.json — so it must stay untracked, else validate-manifest's
# orphan guard reds (a stray `git add tokens/` once swept it into PR #320).
tokens/src/figma-export/

# Canonical render: the deduplicated dist (render.css + fragments + contract) is
# committed and vendored. Only the self-contained @dsCard bundle projection is a
# local, on-demand build output (Claude Design derives it at /design-sync time).
components/render/dist/bundle/

# Generated at build time (predev / prebuild / pretest), never committed: ~316 KB
# of prose that changes with every content edit. See editor/scripts/gen-search-bodies.ts.
editor/src/generated/search-bodies.json
